{
  "name": "chroma",
  "displayName": "Chroma — Title Bar Colors",
  "description": "Instantly set your VS Code title bar color — native color picker, per-workspace.",
  "version": "1.0.6",
  "publisher": "ashsingh-ai",
  "icon": "icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Themes", "Other"],
  "keywords": ["titlebar", "color", "theme", "customize", "workspace"],
  "repository": { "type": "git", "url": "https://github.com/ashsingh-ai/chroma-vscode" },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "titlebarColor.pick",
        "title": "Chroma: Pick Color",
        "icon": "$(symbol-color)"
      },
      {
        "command": "titlebarColor.reset",
        "title": "Chroma: Reset to Default"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.22.0"
  }
}
